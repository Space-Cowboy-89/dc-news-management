<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">


    <!--Tabelle già create:
           - review
           - contest
           - comment
           - category
           - image
           - news
           - preview
           - journalist
    -->
    

    <changeSet id="creation_tables" author="space-cowboy-89">

        <!-- category -->
        <createTable tableName="Category">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(25)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="category_code" type="VARCHAR(29)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime"/>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
            
            <column name="category_id" type="BIGINT"/>
        </createTable>

        <!-- comment -->
        <createTable tableName="comment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="text" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="comment_code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="positive_vote" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="negative_vote" type="long">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="datetime"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="review_id" type="BIGINT"/>
            <column name="news_id" type="BIGINT"/>
            <column name="preview_id" type="BIGINT"/>
            <column name="comment_id" type="BIGINT"/>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime"/>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
        </createTable>

        <!-- contest -->
        <createTable tableName="contest">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="desc" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="contest_code" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="image_id" type="bigint"/>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime"/>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
        </createTable>



        <!-- preview-->
        
        <createTable tableName="preview">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="summary" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="publication_date" type="datetime">
                <constraints nullable="false" />
            </column>
            <column name="category_id" type = "bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
            <column name="preview_code" type="varchar(20)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="positive_vote" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="negative_vote" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="journalist_code" type="varchar(100)"/>
        </createTable>
        
        <!-- review -->
        <createTable tableName="review">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="review_code" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="pubblication_date" type="datetime">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="positive_vode" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="negative_vote" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime"/>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
            <column name="vote" type="float">
                <constraints nullable="false"/>
            </column>
            <column name="image_id" type="bigint"/>
            <column name="title" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="summary" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="journalist_code" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- image -->
        <createTable tableName="image">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="content" type="BLOB">
                <constraints nullable="false"/>
            </column>
            <column name="image_code" type="varchar(25)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="desc" type="varchar(25)"/>
            <column name="name" type="varchar(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime"/>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
        </createTable>

        <!-- news -->
        <createTable tableName="news">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="news_code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="publication_date" type="datetime" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="positive_vote" type="BIGINT" defaultValueComputed="0">
                <constraints nullable="false"/>
            </column>
            <column name="negative_vote" type="BIGINT" defaultValueComputed="0">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT"/>
            <column name="journalist_code" type="varchar(100)"/>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime"/>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
            <column name="image_id"  type="bigint" />
            <column name="title" type="varchar(20)">
                <constraints checkConstraint="false"/>
            </column>
            <column name="summary" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- journalist -->

        <createTable tableName="journalist">
            <column name="journalist_code" type="varchar(100)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="name" type = "varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="surname" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="email" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type ="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" defaultValueComputed="CURRENT_TIMESTAMP" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="datetime"/>
            <column name="deleted_at" type="datetime"/>
        </createTable>
    </changeSet>


    <changeSet id="add_foreign_key" author="space-cowboy-89">


    <!-- category FK-->

        <!-- FK to category-->
        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="Category"
                                 constraintName="fk_category"
                                 referencedColumnNames="id"
                                 referencedTableName="Category"/>

    <!-- comment FK -->

        <!-- FK to category-->
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="comment"
                                 constraintName="fk_comment__user"
                                 referencedColumnNames="id"
                                 referencedTableName="Category"/>

        <!-- FK to review-->

        <addForeignKeyConstraint baseColumnNames="review_id"
                                 baseTableName="comment"
                                 constraintName="fk_comment__review"
                                 referencedColumnNames="id"
                                 referencedTableName="review"/>

        <!-- FK to news-->

        <addForeignKeyConstraint baseColumnNames="news_id"
                                 baseTableName="comment"
                                 constraintName="fk_comment__news"
                                 referencedColumnNames="id"
                                 referencedTableName="news"/>

        <!-- FK to preview-->

        <addForeignKeyConstraint baseColumnNames="preview_id"
                                 baseTableName="comment"
                                 constraintName="fk_comment__preview"
                                 referencedColumnNames="id"
                                 referencedTableName="preview"/>


        <!-- FK to comment-->

        <addForeignKeyConstraint baseColumnNames="comment_id"
                                 baseTableName="comment"
                                 constraintName="fk_comment_comment"
                                 referencedColumnNames="id"
                                 referencedTableName="comment"/>
    <!-- contest FK-->

        <!-- FK to image-->

        <addForeignKeyConstraint baseColumnNames="image_id"
                                 baseTableName="contest"
                                 constraintName="fk_contest__image"
                                 referencedColumnNames="id"
                                 referencedTableName="image"/>

    <!-- review FK-->

        <!-- FK to category-->

        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="review"
                                 constraintName="fk_review__category"
                                 referencedColumnNames="id"
                                 referencedTableName="category"/>

        <!-- FK to image-->

        <addForeignKeyConstraint baseColumnNames="image_id"
                                 baseTableName="review"
                                 constraintName="fk_review__image"
                                 referencedColumnNames="id"
                                 referencedTableName="image"/>

        <!-- FK to journalist-->

        <addForeignKeyConstraint baseColumnNames="journalist_code"
                                 baseTableName="review"
                                 constraintName="fk_review__journalist"
                                 referencedColumnNames="journalist_code"
                                 referencedTableName="journalist"/>
    <!-- news FK-->

        <!-- FK to journalist-->
        <addForeignKeyConstraint baseColumnNames="journalist_code"
                                 baseTableName="news"
                                 constraintName="fk_news_journalist"
                                 referencedColumnNames="journalist_code"
                                 referencedTableName="journalist"/>

        <!-- FK to image-->
        <addForeignKeyConstraint baseColumnNames="image_id"
                                 baseTableName="news"
                                 constraintName="fk_news_image"
                                 referencedColumnNames="id"
                                 referencedTableName="image"/>

        <!-- FK to category-->
        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="news"
                                 constraintName="fk_news_category"
                                 referencedColumnNames="id"
                                 referencedTableName="category"/>

    <!-- preview FK-->

        <!-- FK to category-->

        <addForeignKeyConstraint baseColumnNames="category_id"
                                 baseTableName="preview"
                                 constraintName="fk_preview_category"
                                 referencedColumnNames="id"
                                 referencedTableName="category"/>

        <!-- FK to journalist -->

        <addForeignKeyConstraint baseColumnNames="journalist_code"
                                 baseTableName="preview"
                                 constraintName="fk_preview_journalist"
                                 referencedColumnNames="journalist_code"
                                 referencedTableName="journalist"/>

    </changeSet>


    <changeSet id="adding_check_constraint_1" author="space-cowboy-89">

    <!-- check constraint in review-->
    <sql>
        ALTER TABLE review
        ADD CONSTRAINT chk_review_vote
        CHECK (vote >= 0) and (vote &lt; 11);

    </sql>

    </changeSet>

</databaseChangeLog>
